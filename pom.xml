<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>org.example</groupId>
    <artifactId>assignment</artifactId>
    <version>1.0-SNAPSHOT</version>
    <!-- WAR so the app can be deployed to an external Tomcat; it is still runnable with java -jar. -->
    <packaging>war</packaging>
    <name>hello-world-api</name>
    <description>Simple HTTP API exposing GET /hello-world</description>

    <properties>
        <java.version>21</java.version>
        <!-- springdoc 2.x is the line for Spring Boot 3.x (3.x of springdoc targets Boot 4). -->
        <springdoc.version>2.10.1</springdoc.version>
        <!--
          Security patches: newer versions than Spring Boot 3.5.16 ships with, to fix known
          vulnerabilities (CVE scan). Same minor versions, so no API changes.
          Remove these overrides when upgrading Spring Boot.
        -->
        <tomcat.version>10.1.62</tomcat.version>
        <jackson-bom.version>2.21.8</jackson-bom.version>
        <log4j2.version>2.25.5</log4j2.version>
        <commons-lang3.version>3.22.0</commons-lang3.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- OpenAPI 3 spec at /v3/api-docs and Swagger UI at /swagger-ui.html -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!--
            Embedded Tomcat is "provided": an external Tomcat supplies its own server classes, so
            these jars must not be in WEB-INF/lib. Spring Boot still packages them in
            WEB-INF/lib-provided, so "java -jar" and IntelliJ (with provided scope on the
            classpath) keep using the embedded server.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-tomcat</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- The WAR file name becomes the context path in Tomcat: /hello-world-api -->
        <finalName>hello-world-api</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
